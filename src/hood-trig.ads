--  Table trigonometry. Angles are 1/1024 of a turn (proposed); sine and
--  cosine are scaled by 65536 (proposed) and read from the quarter-wave
--  table in Hood.Trig_Table (generated by tools/gen-trig.py).
with Interfaces;
with Hood.Units;

package Hood.Trig with Pure is

   use Interfaces;

   Steps : constant := 1_024;
   One   : constant := 65_536;

   type Angle is mod Steps;

   Quarter_Turn : constant := Steps / 4;
   Eighth_Turn  : constant := Steps / 8;
   Half_Turn    : constant := Steps / 2;

   function Sin (A : Angle) return Integer_32
     with Post => Sin'Result in -One .. One;

   function Cos (A : Angle) return Integer_32 is (Sin (A + Quarter_Turn))
     with Post => Cos'Result in -One .. One;

   function Atan2 (Y, X : Hood.Units.Units) return Angle;
   --  The direction of (X, Y), counter-clockwise from +X, within one step
   --  of the exact angle; 0 for (0, 0).

end Hood.Trig;
